# Sandbox management service Dockerfile
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    docker.io \
    git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock* ./
RUN pip install --no-cache-dir uv && uv sync --frozen

COPY . .

ENV SANDBOX_CONFIG_PATH=/app/config/sandbox/config.yaml \
    SANDBOX_SERVICE_HOST=0.0.0.0 \
    SANDBOX_SERVICE_PORT=8003

EXPOSE 8003

HEALTHCHECK --interval=10s --timeout=5s --retries=12 CMD curl -fsS http://127.0.0.1:8003/health || exit 1

CMD ["uv", "run", "python", "-m", "src.sandbox.main"]
