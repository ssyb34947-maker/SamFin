# Runtime image used by sandbox worker containers.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    nodejs \
    npm \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    duckdb \
    matplotlib \
    numpy \
    openpyxl \
    pandas \
    pyarrow \
    scipy

RUN useradd --create-home --uid 1000 sandbox

WORKDIR /workspace
USER sandbox

CMD ["sleep", "infinity"]
